{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "asiatechnostroy",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-31",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/send", "/health"]
  },
  "ratelimits": [
    {
      "name": "LEAD_RATE_LIMITER",
      "namespace_id": "1205539807",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
